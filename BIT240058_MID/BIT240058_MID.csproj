<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Project ASP.NET Core MVC - Đề kiểm tra giữa kỳ "Quản lý món ăn"
    MSSV: BIT240058
    Nếu máy chỉ cài .NET 9 thì đổi net8.0 -> net9.0 và Version các package -> 9.0.0
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BIT240058_MID</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ORM: Entity Framework Core cho SQL Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
  </ItemGroup>

</Project>
