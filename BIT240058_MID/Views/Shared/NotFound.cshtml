@model string
@{
    // Trang 404 thân thiện: Id món / loại món / ảnh không tồn tại, đường dẫn sai...
    ViewData["Title"] = L["Not found"].Value;
}

<div class="card card-body text-center py-5 mx-auto" style="max-width: 640px">
    <div class="display-4 fw-bold text-secondary">404</div>
    <h1 class="h4 mt-2">@L["Not found"]</h1>
    <p class="text-muted">@Model</p>
    <div>
        <a class="btn btn-primary" asp-controller="Dishes" asp-action="Index">@L["Back to dish list"]</a>
    </div>
</div>
