@{
    // Ngôn ngữ hiện tại: "en" hoặc "vi"
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    // URL hiện tại (kèm query string) -> sau khi đổi ngôn ngữ quay lại đúng trang,
    // giữ nguyên các điều kiện tìm kiếm / lọc / sắp xếp
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | @L["Dish Management"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    @* ===== MENU ===== *@
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Dishes" asp-action="Index">🍜 @L["Dish Management"]</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Dishes" asp-action="Index">@L["Dishes"]</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="DishCategories" asp-action="Index">@L["Dish categories"]</a></li>
            </ul>

            @* ===== NÚT CHUYỂN NGÔN NGỮ English / Tiếng Việt ===== *@
            <div class="btn-group btn-group-sm" role="group" aria-label="Language">
              <a class="btn @(lang == "en" ? "btn-light" : "btn-outline-light")"
   asp-controller="Language" asp-action="Set" asp-route-culture="en" asp-route-returnUrl="@returnUrl">
    <img src="~/img/flag-gb.svg" class="flag" alt="" /> English
</a>
<a class="btn @(lang == "vi" ? "btn-light" : "btn-outline-light")"
   asp-controller="Language" asp-action="Set" asp-route-culture="vi" asp-route-returnUrl="@returnUrl">
    <img src="~/img/flag-vn.svg" class="flag" alt="" /> Tiếng Việt
</a>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @* ===== Thông báo thành công / lỗi sau khi thao tác (TempData) ===== *@
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="container text-muted small pb-4">BIT240058 · @L["Midterm test - Dish Management"]</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
