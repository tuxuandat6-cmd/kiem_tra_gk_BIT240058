@model Dish_BIT240058
@{
    ViewData["Title"] = L["Edit dish"].Value;
}

<div style="max-width: 760px">
    <h1 class="h3 mb-3">@L["Edit dish"]</h1>

    @* Form gửi POST tới /Dishes/Edit/{id} *@
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body" novalidate>
        <input type="hidden" asp-for="Id" />
        <partial name="_DishForm" model="Model" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">@L["Save"]</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>
