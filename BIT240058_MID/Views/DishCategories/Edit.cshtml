@model DishCategory_BIT240058
@{
    ViewData["Title"] = L["Edit category"].Value;
}

<div style="max-width: 640px">
    <h1 class="h3 mb-3">@L["Edit category"]</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body" novalidate>
        <input type="hidden" asp-for="Id" />
        <partial name="_CategoryForm" model="Model" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">@L["Save"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>
